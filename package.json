{
  "name": "ai-trading-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "dev:server": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "vite:preview": "vite preview --host 0.0.0.0",
    "preview": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "serve": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "local": "npm run build && node --disable-warning=ExperimentalWarning server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
